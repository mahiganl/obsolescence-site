---
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '@fontsource-variable/inter';
import '@fontsource-variable/lora';
import '@fontsource-variable/lora/wght-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import MobileMenu from '../components/MobileMenu.astro';
import { languages, getAlternateLang, getAlternateSlug, type Lang } from '../i18n/config';
import defaultOgImage from '../../assets/colored-drawings/introduction.png';

interface Props {
  title: string;
  lang: Lang;
  currentSlug?: string;
  hideTitle?: boolean;
  tagline?: string;
  ogImage?: ImageMetadata;
  description?: string;
}

const { title, lang, currentSlug, hideTitle = false, tagline, ogImage, description } = Astro.props;
const bookTitle = languages[lang].bookTitle;
const siteUrl = `https://${languages[lang].domain}`;
const alternateLang = getAlternateLang(lang);

// URL canonique (toujours avec / final, comme servi par Netlify).
// /fr/ et /fr/introduction/ ont le même contenu : l'introduction est la version canonique.
const pageUrl = (l: Lang, slug: string) => `https://${languages[l].domain}/${l}/${slug}/`;
const canonicalUrl = currentSlug ? pageUrl(lang, currentSlug) : `${siteUrl}${Astro.url.pathname}`;
const alternateUrl = currentSlug ? pageUrl(alternateLang, getAlternateSlug(lang, currentSlug)) : undefined;
const frUrl = lang === 'fr' ? canonicalUrl : alternateUrl;
const isIntro = currentSlug === 'introduction';

// Image de partage : JPEG 1200 px (l'original PNG fait 5-7 Mo, trop lourd pour les réseaux sociaux)
const og = await getImage({ src: ogImage ?? defaultOgImage, width: 1200, format: 'jpeg', quality: 80 });
const ogImageUrl = new URL(og.src, siteUrl).href;
const bookCover = ogImage ? await getImage({ src: defaultOgImage, width: 1200, format: 'jpeg', quality: 80 }) : og;
const bookImageUrl = new URL(bookCover.src, siteUrl).href;

// Rendu du contenu une seule fois, pour en tirer une meta description propre à chaque page
const content = await Astro.slots.render('default');

function excerpt(html: string, max = 158): string {
  const start = html.indexOf('<article');
  const body = start >= 0 ? html.slice(start) : html;
  const paragraphs = [...body.matchAll(/<(p|li)(?:\s[^>]*)?>([\s\S]*?)<\/\1>/g)]
    .map((m) => m[2].replace(/<sup[\s\S]*?<\/sup>/g, '').replace(/<[^>]+>/g, ''))
    .map((t) => t
      .replace(/&#(\d+);/g, (_, n) => String.fromCharCode(Number(n)))
      .replace(/&#x([0-9a-f]+);/gi, (_, n) => String.fromCharCode(parseInt(n, 16)))
      .replace(/&nbsp;/g, ' ').replace(/&quot;/g, '"').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&')
      .replace(/\s+/g, ' ').trim())
    .filter(Boolean);
  let text = paragraphs.join(' ');
  if (text.length <= max) return text;
  text = text.slice(0, max);
  return text.slice(0, text.lastIndexOf(' ')).replace(/[\s,;:–—-]+$/, '') + '…';
}

const metaDescription = description || excerpt(content) || bookTitle;
const fullTitle = isIntro ? `${bookTitle} – ${title}` : `${title} | ${bookTitle}`;

// Données structurées (schema.org) : le livre, et chaque chapitre comme article qui en fait partie
const author = {
  '@type': 'Person',
  name: 'Mahigan Lepage',
  url: 'https://mahigan.com/',
  sameAs: ['https://x.com/mahiganL', 'https://mahigan.substack.com/'],
};
const book = {
  '@type': 'Book',
  name: bookTitle,
  url: pageUrl(lang, 'introduction'),
  author,
  inLanguage: lang,
  datePublished: '2026-01',
  bookFormat: 'https://schema.org/EBook',
  image: bookImageUrl,
};
const jsonLd = isIntro
  ? {
      '@context': 'https://schema.org',
      ...book,
      description: metaDescription,
      workTranslation: { '@type': 'Book', name: languages[alternateLang].bookTitle, url: pageUrl(alternateLang, 'introduction'), inLanguage: alternateLang },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description: metaDescription,
      url: canonicalUrl,
      mainEntityOfPage: canonicalUrl,
      image: ogImageUrl,
      inLanguage: lang,
      author,
      isPartOf: book,
    };
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="author" content="Mahigan Lepage" />
    <link rel="canonical" href={canonicalUrl} />
    {alternateUrl && (
      <>
        <link rel="alternate" hreflang={lang} href={canonicalUrl} />
        <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
        <link rel="alternate" hreflang="x-default" href={frUrl} />
      </>
    )}
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="theme-color" content="#1a1a2e" />
    <!-- Open Graph / Facebook / LINE -->
    <meta property="og:type" content={isIntro ? 'book' : 'article'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(og.attributes.width)} />
    <meta property="og:image:height" content={String(og.attributes.height)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:site_name" content={bookTitle} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_US' : 'fr_FR'} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@mahiganL" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{fullTitle}</title>
    <ClientRouter />
    <script is:inline>
      // Initialize theme before page renders to prevent flash
      (function() {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen transition-colors duration-300">
    <div class="flex min-h-screen">
      <!-- Desktop Sidebar -->
      <Sidebar lang={lang} currentSlug={currentSlug} />

      <!-- Main Content Area -->
      <div class="flex-1 lg:ml-72">
        <Header lang={lang} currentSlug={currentSlug} hideTitle={hideTitle} tagline={tagline} />

        <main class="px-4 sm:px-6 lg:px-8 py-8 max-w-3xl mx-auto" transition:animate="fade">
          <Fragment set:html={content} />
        </main>

        <!-- Footer -->
        <footer class="px-4 sm:px-6 lg:px-8 py-8 max-w-3xl mx-auto border-t border-stone-200 dark:border-stone-800">
          <div class="flex items-center justify-between text-sm text-stone-500 dark:text-stone-400">
            <span>&copy; {new Date().getFullYear()} Mahigan Lepage</span>
            <div class="flex items-center gap-4">
              <a
                href="https://mahigan.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-stone-700 dark:hover:text-stone-300 transition-colors"
                aria-label="mahigan.com"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                </svg>
              </a>
              <a
                href="https://x.com/mahiganL"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-stone-700 dark:hover:text-stone-300 transition-colors"
                aria-label="Twitter/X"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
              <a
                href="https://mahigan.substack.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-stone-700 dark:hover:text-stone-300 transition-colors"
                aria-label="Substack"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/>
                </svg>
              </a>
            </div>
          </div>
        </footer>
      </div>
    </div>

    <!-- Mobile Menu Overlay -->
    <MobileMenu lang={lang} currentSlug={currentSlug} />

    <script>
      // Theme toggle functionality
      function initTheme() {
        const html = document.documentElement;
        const body = document.body;

        // Sync body class with html class
        if (html.classList.contains('dark')) {
          body.classList.add('dark');
        }

        // Listen for theme toggle clicks
        document.querySelectorAll('[data-theme-toggle]').forEach(btn => {
          btn.addEventListener('click', () => {
            const isDark = html.classList.toggle('dark');
            body.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
          });
        });
      }

      // Mobile menu functionality
      function initMobileMenu() {
        const menuBtn = document.querySelector('[data-menu-toggle]');
        const menu = document.getElementById('mobile-menu');
        const closeBtn = document.querySelector('[data-menu-close]');
        const backdrop = document.querySelector('[data-menu-backdrop]');

        function openMenu() {
          menu?.classList.remove('translate-x-full');
          menu?.classList.add('translate-x-0');
          backdrop?.classList.remove('opacity-0', 'pointer-events-none');
          backdrop?.classList.add('opacity-100');
          document.body.style.overflow = 'hidden';
        }

        function closeMenu() {
          menu?.classList.add('translate-x-full');
          menu?.classList.remove('translate-x-0');
          backdrop?.classList.add('opacity-0', 'pointer-events-none');
          backdrop?.classList.remove('opacity-100');
          document.body.style.overflow = '';
        }

        menuBtn?.addEventListener('click', openMenu);
        closeBtn?.addEventListener('click', closeMenu);
        backdrop?.addEventListener('click', closeMenu);
      }

      // Initialize on page load and after view transitions
      initTheme();
      initMobileMenu();

      // Preserve dark mode during View Transitions
      document.addEventListener('astro:before-swap', (event) => {
        const isDark = document.documentElement.classList.contains('dark');
        // Apply dark class to incoming document
        event.newDocument.documentElement.classList.toggle('dark', isDark);
        event.newDocument.body.classList.toggle('dark', isDark);
      });

      document.addEventListener('astro:after-swap', () => {
        initTheme();
        initMobileMenu();
      });
    </script>
  </body>
</html>
