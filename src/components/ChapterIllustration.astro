---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, type Lang } from '../i18n/config';

interface Props {
  src: ImageMetadata;
  alt: string;
  lang: Lang;
}

const { src, alt, lang } = Astro.props;
---

<figure class="mb-10">
  <!-- Image principale de la page (LCP) : formats modernes, tailles adaptées à l'écran -->
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="jpeg"
    widths={[400, 672, 1000, 1344]}
    sizes="(min-width: 672px) 672px, 100vw"
    quality={70}
    class="w-full h-auto max-w-2xl mx-auto rounded-lg shadow-md"
    loading="eager"
    fetchpriority="high"
  />
  <figcaption class="text-center text-sm text-stone-500 dark:text-stone-400 mt-3 italic">
    {t(lang, 'illustration.caption')}
  </figcaption>
</figure>
